# Per-environment values. The real file is <env>-alloy.env in openlmis-config
# (it carries the ingest token); deploy_alloy.sh copies it here as .env.

DOCKER_HOST=tcp://uat.openlmis.org:2376

ALLOY_VERSION=v1.20.1

# Keep stable: config.alloy drops the agent's own logs by this project name.
COMPOSE_PROJECT_NAME=soldevelo-monitoring-agents

# Identity labels. environment is the monitoring enum: Test=staging, UAT=uat, Demo=prod.
APP=openlmis
DEPLOYMENT=core
ENVIRONMENT=uat
TARGET_NAME=core-uat

INGEST_METRICS_URL=https://olmis-monitoring.soldevelo.com/ingest/prometheus/api/v1/write
INGEST_LOGS_URL=https://olmis-monitoring.soldevelo.com/ingest/loki/loki/api/v1/push
# Must equal INGEST_TOKEN in the monitoring host's .env. Never commit it here.
INGEST_TOKEN=__set_in_openlmis_config__

# Compose services whose container logs never leave the host (Test: scalyr).
LOG_DROP_SERVICES=
